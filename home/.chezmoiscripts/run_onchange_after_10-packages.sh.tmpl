#!/bin/bash
set -euo pipefail

# ------------------------------------------------------------------------------
# Package Installation (brew bundle)
# ------------------------------------------------------------------------------
# Installs everything declared in .chezmoidata/packages.yaml, rendered to
# ~/.Brewfile (applied before this script runs, as it is an _after_ script).
#
# Re-runs whenever the rendered Brewfile changes; the hash below is what
# chezmoi sees change:
#   Brewfile sha256: {{ includeTemplate "Brewfile" . | sha256sum }}
#
# --no-upgrade: only install what's missing, like the old per-package loop.
# Upgrades stay a deliberate `brew upgrade` / `brew bundle upgrade --global`.
#
# Failures don't abort chezmoi apply (the old script tolerated cask
# failures too). The usual cause is an app installed by hand rather than via
# Homebrew ("It seems there is already an App at ..."). Fix with:
#   brew install --cask --adopt <name>
# ------------------------------------------------------------------------------

{{- if eq .chezmoi.os "darwin" }}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{- else }}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv 2>/dev/null || true)"
{{- end }}

brewfile="$HOME/.Brewfile"

echo "📦 Installing packages from $brewfile ..."
if brew bundle install --file="$brewfile" --no-upgrade; then
  echo "✅ All declared packages installed"
else
  echo ""
  echo "⚠️  brew bundle reported failures. Still missing:"
  brew bundle check --file="$brewfile" --verbose --no-upgrade || true
  echo ""
  echo "   If an app was installed outside Homebrew, adopt it with:"
  echo "     brew install --cask --adopt <name>"
  echo "   then re-check with: brew bundle check --global --verbose --no-upgrade"
fi

echo "📁 Creating directories..."
mkdir -p ~/code/{work,personal}

echo "✅ Done"
