" ------------------------------------------------------------------------------
" Vim Configuration
" ------------------------------------------------------------------------------

" --- Core ---

syntax on
set number
set relativenumber
set tabstop=2
set shiftwidth=2
set expandtab
set autoindent
set background=dark

" --- Filetype indentation ---

augroup FileTypeIndent
  autocmd!
  autocmd FileType python setlocal shiftwidth=4 softtabstop=4 expandtab textwidth=79 colorcolumn=88
  autocmd FileType javascript,typescript,javascriptreact,typescriptreact setlocal shiftwidth=2 softtabstop=2 expandtab textwidth=100 colorcolumn=100
  autocmd FileType yaml setlocal shiftwidth=2 softtabstop=2 expandtab indentkeys-=0#
  autocmd FileType json,jsonc setlocal shiftwidth=2 softtabstop=2 expandtab
  autocmd FileType toml setlocal shiftwidth=2 softtabstop=2 expandtab
  autocmd FileType tf setlocal shiftwidth=2 softtabstop=2 expandtab
  autocmd FileType ruby,eruby setlocal shiftwidth=2 softtabstop=2 expandtab
  autocmd FileType sh setlocal shiftwidth=2 softtabstop=2 expandtab
  autocmd FileType dockerfile setlocal shiftwidth=2 softtabstop=2 expandtab
  autocmd FileType c setlocal cindent shiftwidth=4 softtabstop=4 expandtab
  autocmd FileType go setlocal noexpandtab shiftwidth=4 tabstop=4
augroup END

" --- Snippets ---
" Note: section-divider/header snippets below use "#"-style comments,
" intended for shell/config/TOML files rather than vim/Go/etc.

" Section divider: \d in normal mode
" Types "# ---  ---" and positions cursor between the dashes to type a label
nnoremap <leader>d i# ---  ---<Esc>hhi

" File header: \h in normal mode
nnoremap <leader>h i# ------------------------------------------------------------------------------<CR># <CR># ------------------------------------------------------------------------------<Esc>kA
